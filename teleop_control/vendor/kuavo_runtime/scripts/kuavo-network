#!/usr/bin/env bash
set -euo pipefail

RUNTIME_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${RUNTIME_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"

# sudo may clear PYTHONDONTWRITEBYTECODE. Keep packaged clients free of
# generated bytecode even when this helper runs with a sanitized environment.
exec python3 -B -m teleop.robots.kuavo_network "$@"
