%% 2026-09-09：绿色=已完成所标范围验收；橙色=部分能力/外部硬件限制/跨厂商待验证；灰色=未实现。
flowchart TB
    subgraph INPUT["① PICO 输入统一为 XRFrame"]
        direction LR
        PICO["PICO / Unity<br/>头显、左右手柄、按键"] --> BRIDGE["PC 输入桥<br/>RoboticsServiceProcess<br/>+ XRoboToolkitInputAdapter"]
        BRIDGE --> XR["XRFrame<br/>统一、带时间戳的输入事实"]
    end

    subgraph CONTROL["② 先生成机器人无关 Intent，再由 ControlRouter 分流"]
        CURRENT["启动入口用 --mode 选择 Mapper / Retargeting（会话内固定）<br/>joint-jog → JointJogIntent<br/>dual-arm：RobotState / FK Grip 锚点 + 手柄相对运动<br/>→ EndEffectorPoseIntent → 末端工作空间限制<br/>Trigger → GripperIntent（独立）"]
        HEADIN["可选头部跟随<br/>HeadFollowMapper → HeadOrientationIntent<br/>G2HeadJointMapper + G2 起点 → JointPositionIntent<br/>左右 / 上下跟随，不跟随歪头"]
        ROUTER["ControlRouter<br/>不选择模式或机器人"]
        JOINT["单关节直控<br/>JointJogIntent / JointPositionIntent → JointCommand<br/>不使用 IK"]
        ARMIK["双臂末端控制<br/>受限后的 EndEffectorPoseIntent → RobotAdapter.solve_ik()<br/>当前注入 G2URDFIKSolver → JointCommand"]
        GRIP["左右夹爪<br/>GripperIntent → GripperCommand<br/>不使用 IK"]
        HEADCMD["头部直接关节控制<br/>DirectJointBackend → JointCommand<br/>角度 / 速率 / 时效 / 反馈检查<br/>不使用 IK；软件安全范围已冻结"]
        FUTURE["全身姿态 / 行走（后续）<br/>Intent、Backend 与安全尚未实现"]
        SAFE["实时安全与连续控制<br/>分别检查关节和夹爪命令<br/>stale 当前帧不发送；Adapter 最终复查"]

        CURRENT --> ROUTER
        HEADIN --> ROUTER
        ROUTER --> JOINT --> SAFE
        ROUTER --> ARMIK --> SAFE
        ROUTER --> GRIP --> SAFE
        ROUTER --> HEADCMD
        ROUTER -.-> FUTURE
    end

    subgraph ADAPTER["③ 同一个 RobotAdapter：安全前提供 IK，安全后执行发送"]
        API["RobotAdapter 统一接口边界<br/>机器人/夹爪状态 / joint schema / capabilities<br/>安全前 solve_ik；安全后 joint+gripper send / stop<br/>G2 已使用；跨厂商待第二种真机验证"]
        subgraph LOCAL["A. 双臂末端使用本地 URDF IK"]
            G2LOCAL["G2Adapter → agibot_gdk → G2<br/>双臂：G2URDFIKSolver<br/>单关节 / 双臂 / 双夹爪已验收"]
            LEJULOCAL["乐聚（计划）<br/>LejuAdapter + 乐聚专用 URDF IK<br/>→ 乐聚控制 SDK；未实现"]
        end
        subgraph NATIVE["B. 厂商原生 IK（官方提供且完成接入验证）"]
            NATIVEVENDOR["VendorAdapter + IKSolver(kind=native)<br/>→ 厂商官方 IK / 控制 SDK<br/>未实现"]
        end

        HEADEXEC["头部专用状态的 G2Adapter<br/>G2NormalHeadSender → GDK 头部伺服<br/>受限范围真机链路已验证并冻结"]
        HEADLIMIT["G2 本体已知限制<br/>本机操作也复现右转受阻 / 异常<br/>yaw 暂限 [-8°, +45°]<br/>完整右转范围须厂家检修后重验"]
        API --> G2LOCAL
        API -.-> LEJULOCAL
        API -.-> NATIVEVENDOR
        HEADEXEC -.-> HEADLIMIT
    end

    HEADCMD --> HEADEXEC

    subgraph VIDEO["④ 独立视频回传（不进入控制链路）"]
        direction LR
        VS["G2 kHeadColor<br/>G2VideoSource / RobotVideoSource"] --> VH["PC VideoHub<br/>TCP 63902 · 最新帧"]
        VH --> VC["PICO + PC Viewer"]
    end

    subgraph SUPPORT["⑤ 启动管理与参考"]
        direction LR
        SESSION["统一启动脚本<br/>单关节或双臂/夹爪 + 视频已冻结<br/>可选头部在受限范围内已整合冻结"]
        HEADSESSION["独立头部入口保留<br/>不与统一会话并开；异步诊断日志"]
        TODO["集合平台 / Recorder / Monitor<br/>计划中，尚未实现"]
        LEGACY["test-teleop<br/>旧实现参考，不属于当前运行链路"]
    end

    XR --> CURRENT
    XR --> HEADIN
    SAFE -->|仅发送已验证命令| API

    classDef done fill:#DCFCE7,stroke:#16A34A,color:#14532D,stroke-width:2px;
    classDef partial fill:#FFEDD5,stroke:#F97316,color:#7C2D12,stroke-width:2px;
    classDef todo fill:#F3F4F6,stroke:#9CA3AF,color:#374151,stroke-width:1.5px;
    classDef legacy fill:#FFFFFF,stroke:#94A3B8,color:#475569,stroke-width:1.5px,stroke-dasharray:5 5;
    class PICO,BRIDGE,XR,CURRENT,ROUTER,JOINT,ARMIK,GRIP,SAFE,G2LOCAL,VS,VH,VC done;
    class API,HEADLIMIT partial;
    class HEADIN,HEADCMD,HEADEXEC,HEADSESSION,SESSION done;
    class FUTURE,LEJULOCAL,NATIVEVENDOR,TODO todo;
    class LEGACY legacy;
