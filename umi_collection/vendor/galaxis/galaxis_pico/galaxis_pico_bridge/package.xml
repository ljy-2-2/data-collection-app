<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>galaxis_pico_bridge</name>
  <version>0.0.1</version>
  <description>
    ROS 2 bridge node that ingests Galaxis PICO 4 Ultra HMD and controller
    data, publishes timestamped sensor topics, and maintains /tf and
    /pico/controller joy outputs for data collection.
  </description>
  <maintainer email="jumpei_arima@mail.toyota.co.jp">Jumpei Arima</maintainer>
  <maintainer email="okubo.takuya@airoa.org">Takuya Okubo</maintainer>
  <license>Apache License 2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>galaxis_pico_msgs</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
