<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="galaxis_hands">
  <!-- Collection-only kinematics: metres/radians, X forward, Y left, Z up.
       Mechanical reference: 总设计（共享）/手持组装.SLDASM, configuration Défaut.
       Gear spacing, camera geometry and camera mounting transform are read from
       this saved original assembly, not the later Windows camera design.
       See the vendor/galaxis docs:
       galaxis_hand_mirror_analysis_zh.md and galaxis_hand_cad_measurements.json.
       Visual/collision geometry is omitted; all recorded TF frames are retained. -->
  <!-- Half the CAD-measured 33 mm axis spacing. Root is midway between axes
       at the thickness mid-plane of the 7 mm gears; +Z points to the upper case. -->
  <xacro:property name="finger_offset_y" value="0.0165"/>
  <!-- UNCALIBRATED nominal right-finger contact point at encoder q=0 (signed Y).
       Retained: CAD does not identify this contact landmark or encoder zero.
       Do not use the unequal saved CAD finger angles as closed-zero offsets. -->
  <xacro:property name="finger_tip_offset_x" value="0.09145"/>
  <xacro:property name="finger_tip_offset_y" value="0.0"/>
  <xacro:property name="finger_tip_offset_z" value="0.0"/>

  <!-- Original saved CAD lens-front centre at camera-local (0,0,25.5) mm,
       a mechanical reference, not a calibrated
       optical centre. Camera link uses +X forward, +Y left, +Z up (not optical
       +Z forward). Positive pitch tips +X down. The centred, unrolled camera
       is invariant under the hands' XZ reflection: both poses are identical. -->
  <xacro:property name="camera_x" value="0.027181633778"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.061854719162"/>
  <xacro:property name="camera_roll" value="0.0"/>
  <xacro:property name="camera_pitch" value="0.6981317007977318"/>
  <xacro:property name="camera_yaw" value="0.0"/>
  <!-- User-designated PICO centre: H33 Quest reference transferred by rigid
       grip alignment (bottom datum, fitted grip axis and section direction;
       no scaling). See pico_center_reference in galaxis_hand_cad_measurements.json.
       This replaces the H18.2 trigger-rim origin; +X retains the previous
       Aim direction, forward and UP 45 degrees, rather than Quest orientation.
       Edit only this right-hand reference; the left mount mirrors it across XZ:
       xyz=(x,-y,z), rpy=(-roll,pitch,-yaw). Both frames remain right-handed.
       A ray does not determine roll: retain roll=0, with +Y pointing hand-left.
       SDK-reference equivalence is user-specified, not independently calibrated. -->
  <xacro:property name="mount_x" value="-0.05734"/>
  <xacro:property name="mount_y" value="-0.0285"/>
  <xacro:property name="mount_z" value="0.06362"/>
  <xacro:property name="mount_roll" value="0.0"/>
  <xacro:property name="mount_pitch" value="-0.7853981633974483"/>
  <xacro:property name="mount_yaw" value="0.0"/>

  <!-- JointState q is the SINGLE finger angle in radians. The full opening
       angle is 2*q on /galaxis/gripper/opening_state, NOT a physical joint.
       Do not feed the opening angle into these joints or TF doubles its motion. -->
  <!-- continuous expresses encoder-driven rotation without model limits.
       This collection model does not describe physical travel stops. -->
  <xacro:macro name="finger" params="hand_prefix finger_side side_sign hand_sign active_side">
    <joint name="${hand_prefix}_${finger_side}_finger_joint" type="continuous">
      <origin xyz="0 ${side_sign * finger_offset_y} 0" rpy="0 0 0"/>
      <parent link="${hand_prefix}_hand_root"/>
      <child link="${hand_prefix}_${finger_side}_finger_link"/>
      <!-- Mirrored axes: both right-hand joints -Z, both left-hand joints +Z.
           Active q increases on opening; the passive joint has q_passive=-q. -->
      <axis xyz="0 0 ${hand_sign}"/>
      <xacro:unless value="${finger_side == active_side}">
        <mimic joint="${hand_prefix}_${active_side}_finger_joint" multiplier="-1" offset="0"/>
      </xacro:unless>
    </joint>
    <link name="${hand_prefix}_${finger_side}_finger_link"/>
    <joint name="${hand_prefix}_${finger_side}_finger_tip_joint" type="fixed">
      <origin xyz="${finger_tip_offset_x} ${-side_sign * finger_tip_offset_y} ${finger_tip_offset_z}" rpy="0 0 0"/>
      <parent link="${hand_prefix}_${finger_side}_finger_link"/>
      <child link="${hand_prefix}_${finger_side}_finger_tip_link"/>
    </joint>
    <link name="${hand_prefix}_${finger_side}_finger_tip_link"/>
  </xacro:macro>

  <xacro:macro name="galaxis_hand" params="hand_prefix hand_sign active_side">
    <link name="${hand_prefix}_hand_root"/>
    <joint name="${hand_prefix}_camera_joint" type="fixed">
      <origin xyz="${camera_x} ${camera_y} ${camera_z}"
              rpy="${camera_roll} ${camera_pitch} ${camera_yaw}"/>
      <parent link="${hand_prefix}_hand_root"/>
      <child link="${hand_prefix}_hand_cam_link"/>
    </joint>
    <link name="${hand_prefix}_hand_cam_link"/>
    <xacro:finger hand_prefix="${hand_prefix}" finger_side="right" side_sign="${-1}"
                  hand_sign="${hand_sign}" active_side="${active_side}"/>
    <xacro:finger hand_prefix="${hand_prefix}" finger_side="left" side_sign="${1}"
                  hand_sign="${hand_sign}" active_side="${active_side}"/>
    <joint name="pico_origin_to_${hand_prefix}" type="floating">
      <parent link="pico_origin"/>
      <child link="${hand_prefix}_hand_root"/>
    </joint>
    <joint name="${hand_prefix}_mount_joint" type="fixed">
      <origin xyz="${mount_x} ${-hand_sign * mount_y} ${mount_z}"
              rpy="${-hand_sign * mount_roll} ${mount_pitch} ${-hand_sign * mount_yaw}"/>
      <parent link="${hand_prefix}_hand_root"/>
      <child link="pico_${hand_prefix}_controller"/>
    </joint>
    <link name="pico_${hand_prefix}_controller"/>
  </xacro:macro>

  <link name="pico_origin"/>
  <xacro:galaxis_hand hand_prefix="right" hand_sign="${-1}" active_side="right"/>
  <xacro:galaxis_hand hand_prefix="left" hand_sign="${1}" active_side="left"/>
</robot>
