# platform：使用平台；raw-only：本机原始 rosbag 保存，无需平台登录或上传。
# 仅在需要独立采集的设备设置 raw-only，电脑端默认保留 platform。
DATA_COLLECTION_STORAGE_MODE=platform

# 切换平台时必须同时更新 API 和网页地址；两项不能混用云端和本机。
# python3 scripts/configure_platform.py --api-url https://api.example.com --web-url https://platform.example.com
PLATFORM_API_URL=http://127.0.0.1:8000
PLATFORM_WEB_URL=http://127.0.0.1:5173

APP_HOST=127.0.0.1
APP_PORT=4173
# Qt desktop renderer (restart the App after changing).
# APP_UI_SCALE=1.25  # defaults to the desktop text scaling factor
APP_SOFTWARE_RENDERING=0
LOCAL_CONTROL_HOST=127.0.0.1
LOCAL_CONTROL_PORT=8011
LOCAL_CONTROL_URL=http://127.0.0.1:8011
TELEOP_CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

TELEOP_GDK_APP_ROOT=~/.cache/agibot/app
TELEOP_ROBOT_INTERFACE=auto
TELEOP_OUTPUT=~/agibot_episodes/dual_arm
GDK_RIGHT_ARM_IMPORT_ROOT=~/agibot_episodes/right_arm
# TELEOP_GDK_PYTHON=~/miniforge3/envs/bot/bin/python

UMI_DATA_ROOT=~/galaxis_data
# UMI_PYTHON=/usr/bin/python3
UMI_MONITOR_URL=http://127.0.0.1:8770

# Tianji reuses the XR Python runtime; optional per-machine overrides.
# TIANJI_PYTHON=/path/to/xr-python
# Camera settings can be imported in the UI; the default is per-user and survives upgrades:
# ~/.config/xiaokai-lab-data-collection/tianji-camera/client.json (respects XDG_CONFIG_HOME)
# TIANJI_CAMERA_CREDENTIALS=/path/to/camera-client.json
# TIANJI_CONFIG=/path/to/tianji-config.json
# TIANJI_ROBOT_IP=192.168.1.190
# TIANJI_CAMERA_HOST=192.168.1.190
